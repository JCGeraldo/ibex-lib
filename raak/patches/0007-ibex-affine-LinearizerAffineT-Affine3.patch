diff --git a/src/numeric/ibex_LinearizerAffine2.h b/src/numeric/ibex_LinearizerAffine2.h
index 26d4b86..ebb0edd 100644
--- a/src/numeric/ibex_LinearizerAffine2.h
+++ b/src/numeric/ibex_LinearizerAffine2.h
@@ -21,6 +21,41 @@
 
 namespace ibex {
 
+// [raak local] parche 0007: el linearizador se templatiza sobre el modelo afin T para poder usar
+// tambien AF_fAFFullI (Affine3). LinearizerAffine2 sigue siendo LinearizerAffineT<AF_fAF2>, con el
+// mismo codigo (bit a bit) que antes.
+
+/**
+ * [raak local] Una forma afin es linearizable si esta activa y sus coeficientes noise(i), 0 <= i < nb_var,
+ * son los de las variables. En los modelos densos (AF_fAF2) eso exige noise_count() == nb_var; en
+ * AF_fAFFullI los simbolos de las variables tienen id = var y puede haber ademas rayos con id >= 50, que
+ * se relajan aparte (ver affine_extra_error).
+ */
+template<class T>
+inline bool affine_form_is_linearizable(const AffineMain<T>& af, int nb_var) {
+	return af.is_active() && af.noise_count() == nb_var;
+}
+template<>
+inline bool affine_form_is_linearizable<AF_fAFFullI>(const AffineMain<AF_fAFFullI>& af, int nb_var) {
+	(void) nb_var;
+	return af.is_active();
+}
+
+/**
+ * [raak local] Error adicional que se suma a err() en la relajacion: los simbolos de ruido que no son
+ * variables (id >= nb_var) valen [-1,1], asi que sum |coef| es una relajacion valida de su aporte.
+ * En AF_fAF2 no hay tales simbolos (0). En AF_fAFFullI, err() es solo _garbage.rad() y no los incluye.
+ */
+template<class T>
+inline double affine_extra_error(const AffineMain<T>& af, int nb_var) {
+	(void) af; (void) nb_var;
+	return 0.0;
+}
+template<>
+inline double affine_extra_error<AF_fAFFullI>(const AffineMain<AF_fAFFullI>& af, int nb_var) {
+	return af.nonvar_noise_sum(nb_var);
+}
+
