+++ b/src/arithmetic/ibex_Affine3_fAFFullI.cpp
@@ -193,6 +193,19 @@ double AffineMain<AF_fAFFullI>::err() const{
 	return _elt._garbage.rad();
 }
 
+// [raak local] parche 0007: suma de |coeficiente| de los rayos que no son variables (id >= nb_var),
+// con redondeo hacia arriba (1+2*AF_EM) por suma. El rayo de la variable var tiene id = var
+// (AffineVarMain<AF_fAFFullI>::operator=), y los creados por operaciones no afines tienen id >= 50.
+template<>
+double AffineMain<AF_fAFFullI>::nonvar_noise_sum(int nb_var) const {
+	if (!is_active()) return 0.0;
+	double s = 0.0;
+	std::list<std::pair<af3_int,double> >::const_iterator it;
+	for (it = _elt._rays.begin(); it != _elt._rays.end(); ++it)
+		if (it->first >= (af3_int) nb_var) s = (1+2*AF_EM)*(s + std::fabs(it->second));
+	return s;
+}
+
 
 
