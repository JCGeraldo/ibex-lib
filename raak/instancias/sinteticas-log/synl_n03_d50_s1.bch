constants

variables
x1 in [1e-6, 1];
x2 in [1e-6, 1];
x3 in [1e-6, 1];

minimize
(0.882*x1 - 0.165*x2)*ln(0.9*x1 + 0.876) + (-0.342*x2)*ln(0.823*x2 + 0.732*x3 + 0.488) + (-0.722*x1 - 0.256*x2 + 0.814*x3)*ln(0.356*x1 + 0.106*x2 + 0.132) + (-0.196*x1 + 0.005*x2 - 0.185*x3);

constraints
x1 + x2 + x3 - 1 = 0;

end
