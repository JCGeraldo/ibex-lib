constants

variables
x1 in [1e-6, 1];
x2 in [1e-6, 1];
x3 in [1e-6, 1];

minimize
(-0.019*x1 + 0.386*x2 + 0.677*x3)*ln(0.509*x1 + 0.151*x2 + 0.202*x3 + 0.562) + (-0.2*x1 - 0.414*x2)*ln(0.873*x1 + 0.839*x2 + 0.435*x3 + 0.209) + (-0.571*x1 + 0.57*x2 - 0.83*x3)*ln(0.339*x1 + 0.842*x2 + 0.186) + (-0.364*x1 - 0.267*x2 + 0.102*x3);

constraints
x1 + x2 + x3 - 1 = 0;

end
