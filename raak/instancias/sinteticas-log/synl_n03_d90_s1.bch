constants

variables
x1 in [1e-6, 1];
x2 in [1e-6, 1];
x3 in [1e-6, 1];

minimize
(-0.584*x1 - 0.858*x2 - 0.286*x3)*ln(0.814*x1 + 0.155*x2 + 0.077*x3 + 0.747) + (-0.681*x1 + 0.149*x2 + 0.552*x3)*ln(0.527*x1 + 0.887*x2 + 0.522*x3 + 0.888) + (0.116*x1 - 0.501*x2 + 0.637*x3)*ln(0.089*x1 + 0.875*x2 + 0.718) + (0.04*x1 + 0.38*x2 + 0.822*x3);

constraints
x1 + x2 + x3 - 1 = 0;

end
