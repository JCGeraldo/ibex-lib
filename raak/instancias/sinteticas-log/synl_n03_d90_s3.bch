constants

variables
x1 in [1e-6, 1];
x2 in [1e-6, 1];
x3 in [1e-6, 1];

minimize
(0.749*x3)*ln(0.16*x2 + 0.827) + (-0.314*x1 - 0.122*x2 - 0.349*x3)*ln(0.855*x1 + 0.186*x2 + 0.826*x3 + 0.17) + (0.852*x1 - 0.842*x2 + 0.74*x3)*ln(0.443*x1 + 0.272*x3 + 0.977) + (0.071*x1 + 0.56*x2 + 0.191*x3);

constraints
x1 + x2 + x3 - 1 = 0;

end
