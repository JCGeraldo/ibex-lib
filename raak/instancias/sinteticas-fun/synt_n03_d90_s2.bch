constants

variables
x1 in [-1, 1];
x2 in [-1, 1];
x3 in [-1, 1];

minimize
(-0.283*x1 - 0.704*x2)*sin(-0.792*x1 - 0.134*x2 + 0.059*x3) + cos(-0.996*x2 - 0.683*x3)*exp(-0.058*x1 + 0.909*x2 - 0.087*x3) + (0.523*x1 - 0.069*x2 + 0.061*x3)*exp(0.032*x1 + 0.077*x3) + (-0.271*x1 - 0.612*x2 - 0.26*x3);

constraints
(-0.014*x1 + 0.281*x2 + 0.038*x3) <= 0.5294;

end
