constants

variables
x1 in [-1, 1];
x2 in [-1, 1];
x3 in [-1, 1];

minimize
(0.969*x2)*sin(-0.857*x2) + cos(-0.245*x1 - 0.721*x3)*exp(0.3*x2) + (-0.053*x1 + 0.394*x2 + 0.555*x3)*exp(0.435*x1 + 0.226*x2) + (-0.78*x1 - 0.241*x2 + 0.306*x3);

constraints
(-0.917*x1 + 0.653*x2 + 0.918*x3) <= 0.4272;

end
