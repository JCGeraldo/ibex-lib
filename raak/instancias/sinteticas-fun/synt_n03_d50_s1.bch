constants

variables
x1 in [-1, 1];
x2 in [-1, 1];
x3 in [-1, 1];

minimize
(0.628*x1 + 0.878*x2)*sin(0.045*x1 - 0.058*x3) + cos(0.192*x3)*exp(-0.21*x1 - 0.901*x2 - 0.346*x3) + (-0.27*x1)*exp(-0.888*x2) + (0.061*x1 + 0.961*x2 + 0.932*x3);

constraints
(0.808*x1 + 0.927*x2 + 0.389*x3) <= 0.8629;

end
