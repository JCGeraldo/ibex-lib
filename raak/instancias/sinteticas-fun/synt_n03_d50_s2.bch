constants

variables
x1 in [-1, 1];
x2 in [-1, 1];
x3 in [-1, 1];

minimize
(-0.458*x1 - 0.457*x2)*sin(0.143*x1 + 0.771*x3) + cos(0.399*x1 + 0.163*x3)*exp(0.973*x1 - 0.591*x2) + (0.028*x1 - 0.434*x2 - 0.934*x3)*exp(0.585*x2) + (0.43*x1 - 0.367*x2 + 0.37*x3);

constraints
(-0.51*x1 + 0.283*x2 - 0.512*x3) <= 0.5355;

end
