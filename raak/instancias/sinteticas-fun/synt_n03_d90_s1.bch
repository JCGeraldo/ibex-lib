constants

variables
x1 in [-1, 1];
x2 in [-1, 1];
x3 in [-1, 1];

minimize
(-0.003*x2 - 0.89*x3)*sin(-0.106*x1 + 0.426*x2 - 0.148*x3) + cos(0.503*x1 - 0.013*x2)*exp(-0.764*x1 + 0.34*x2) + (0.153*x1 + 0.251*x2 + 0.496*x3)*exp(0.549*x1 - 0.772*x3) + (0.932*x1 - 0.374*x2 - 0.381*x3);

constraints
(0.586*x1 - 0.661*x2 - 0.997*x3) <= 1.1207;

end
